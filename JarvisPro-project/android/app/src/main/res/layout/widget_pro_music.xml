<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_pro_gold"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/michroma"
            android:letterSpacing="0.14"
            android:text="МУЗЫКА"
            android:textColor="#FFC46B"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/wBig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Музыка"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wPrev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_widget_pro_chip"
        android:gravity="center"
        android:text="⏮"
        android:textColor="#DFE3EA"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/wPlay"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_widget_main_pro_gold"
        android:gravity="center"
        android:text="▶"
        android:textColor="#17110A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wNext"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_widget_pro_chip"
        android:gravity="center"
        android:text="⏭"
        android:textColor="#DFE3EA"
        android:textSize="13sp" />
</LinearLayout>
