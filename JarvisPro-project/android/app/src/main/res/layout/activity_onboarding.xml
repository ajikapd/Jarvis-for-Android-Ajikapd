<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS"
            android:textColor="@color/jarvis_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Офлайн голосовой ассистент"
            android:textColor="@color/jarvis_muted"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Step: RECORD_AUDIO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepRecordAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepRecordAudioStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Доступ к микрофону"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnRecordAudio"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Разрешить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: POST_NOTIFICATIONS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepNotificationsStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. Уведомления"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnNotifications"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Разрешить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: OVERLAY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepOverlayStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3. Оверлей поверх приложений"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnOverlay"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настроить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: BATTERY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepBatteryStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4. Исключение из экономии батареи"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnBattery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настроить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: AUTOSTART -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepAutoStartStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5. Автозапуск (HyperOS)"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnAutoStart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настроить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: ACCESSIBILITY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepAccessibilityStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="6. Accessibility (управление экраном)"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnAccessibility"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настроить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: NOTIFICATION LISTENER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepNotificationListener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepNotificationListenerStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="7. Чтение уведомлений"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnNotificationListener"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настроить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step: WRITE_SETTINGS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepWriteSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stepWriteSettingsStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="8. Изменение системных настроек"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnWriteSettings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настроить"
                    android:textColor="@color/jarvis_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Debug-only: test console (invisible in release) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stepDebugConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            style="@style/Widget.Material3.CardView.Outlined"
            app:cardBackgroundColor="@color/jarvis_panel"
            app:strokeColor="@color/jarvis_border"
            app:strokeWidth="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="9. Тест-консоль (debug)"
                    android:textColor="#FF9800"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnDebugConsole"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Открыть"
                    android:textColor="#FF9800" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Start button -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Запустить Jarvis"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>