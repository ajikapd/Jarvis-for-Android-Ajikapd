<?xml version="1.0" encoding="utf-8"?>
<!--
  GigaChat (Сбер) подписан корневым сертификатом Минцифры, которого нет в Android.
  Доверяем ему только для доменов GigaChat; остальные соединения проверяются как обычно.
  SHA-256 корня: D2:6D:2D:02:31:B7:C3:9F:92:CC:73:85:12:BA:54:10:35:19:E4:40:5D:68:B5:BD:70:3E:97:88:CA:8E:CF:31
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">giga.chat</domain>
        <domain includeSubdomains="false">ngw.devices.sberbank.ru</domain>
        <domain includeSubdomains="false">gigachat.devices.sberbank.ru</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/russian_trusted_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
