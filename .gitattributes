# ── Binary assets (no diff, no EOL handling) ───────────────────────
*.onnx   binary
*.tflite binary
*.so     binary
*.aar    binary
*.zip    binary
*.apk    binary
*.bin    binary

# ── Text sources (normalize to LF in the repository) ───────────────
*.kt     text eol=lf
*.kts    text eol=lf
*.xml    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.gradle text eol=lf
