<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#E6060E18"
                android:startColor="#BF0C1C30" />
            <stroke
                android:width="1dp"
                android:color="#3347EAFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape>
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
