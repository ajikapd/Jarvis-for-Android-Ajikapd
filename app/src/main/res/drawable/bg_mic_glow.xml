<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#4462E9F4"
                android:endColor="#00061018"
                android:gradientRadius="36dp"
                android:startColor="#AAF4FEFF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="#101820" />
            <stroke
                android:width="1.5dp"
                android:color="#62E9F4" />
        </shape>
    </item>
</layer-list>
