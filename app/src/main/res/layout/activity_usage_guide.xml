<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="КАК ПОЛЬЗОВАТЬСЯ JARVIS"
            android:textColor="@color/jarvis_cyan"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Голосовые команды, роутер и быстрые клавиши."
            android:textColor="@color/jarvis_muted"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_panel"
            android:padding="14dp"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ГОЛОС" android:textColor="@color/jarvis_cyan" android:textSize="11sp" android:fontFamily="monospace" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="На Ядре нажми микрофон и дождись ACTIVE. Команда после вейк-слова. В Live вейк-слово не нужно: центр экрана запускает сессию." android:textColor="@color/jarvis_text" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_panel"
            android:padding="14dp"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="РОУТЕР" android:textColor="@color/jarvis_cyan" android:textSize="11sp" android:fontFamily="monospace" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="LOCAL — только модель на телефоне.\nHYBRID — облако, если есть сеть и ключ.\nCLOUD — NaraRouter (agnes / mistral).\nПереключение: кнопка AI ROUTER на Ядре." android:textColor="@color/jarvis_text" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_panel"
            android:padding="14dp"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="БЫСТРЫЕ КЛАВИШИ" android:textColor="@color/jarvis_cyan" android:textSize="11sp" android:fontFamily="monospace" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Шторка Android — плитка J.A.R.V.I.S. поднимает орб.\nОрб: тап — меню, удержание — перенос к краю.\nУведомление сервиса: MUTE / WAKE, LIVE MODE, STOP.\nLive: КАМЕРА — видоискатель, ЭКРАН — метка контекста.\nОпасные инструменты ждут карточку CONFIRM 10 секунд." android:textColor="@color/jarvis_text" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_panel"
            android:padding="14dp"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ПРИМЕРЫ" android:textColor="@color/jarvis_cyan" android:textSize="11sp" android:fontFamily="monospace" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="«включи фонарик»\n«открой Telegram»\n«какая погода в Москве»\n«запомни: вечером лучше тишина»\nНа подтверждение: «да» или «выполняй»." android:textColor="@color/jarvis_text" android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnGuideDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="ПОНЯТНО"
            android:textColor="@color/jarvis_cyan"
            android:fontFamily="monospace"
            android:background="@drawable/bg_fui_active" />

        <TextView
            android:id="@+id/btnGuideCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ОТКРЫТЬ СПИСОК КОМАНД"
            android:textColor="@color/jarvis_cyan"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hud_panel" />
    </LinearLayout>
</ScrollView>
