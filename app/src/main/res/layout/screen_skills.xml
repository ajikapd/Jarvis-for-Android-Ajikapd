<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_bg"
    android:paddingStart="19dp"
    android:paddingEnd="19dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Все возможности JARVIS. Нажми пример — скопируется; «Выполнить» отправит команду, если ассистент активен."
        android:textColor="@color/jarvis_muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/commandsSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⌕  Найти команду…"
        android:textColor="#9DA5AE"
        android:textSize="11sp"
        android:background="@drawable/bg_search"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/commandsCategoryChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/commandsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
