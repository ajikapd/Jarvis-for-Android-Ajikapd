<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/btnBackToControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Кабинет"
            android:textColor="@color/jarvis_cyan"
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ПОВТОРЯЕМЫЕ ДЕЙСТВИЯ"
            android:textColor="@color/jarvis_primary"
            android:textSize="9sp"
            android:letterSpacing="0.14"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Правила, которые повторяются сами."
            android:textColor="@color/jarvis_muted"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/btnCreateRoutine"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ НОВЫЙ ПРОТОКОЛ"
            android:textColor="@color/jarvis_cyan"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_hud_panel"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="АКТИВНЫЕ ПРОТОКОЛЫ"
            android:textColor="@color/jarvis_faint"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:id="@+id/routinesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_panel"
            android:padding="14dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREVIEW"
                android:textColor="@color/jarvis_faint"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/routinePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TRIGGER → ACTION → CONFIRM"
                android:textColor="@color/jarvis_muted"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
